# Preencha só as chaves do fluxo que você vai usar.
# Veja docs/TOOLS-AND-API-KEYS.md para alternativas e requisitos de integração.
# Copie este arquivo para .env na sua máquina. Nunca faça commit da sua chave.

# Transcrição padrão do kit (Deepgram nova-3, pt-BR). O script incluído usa esta chave.
# Crie a chave em https://console.deepgram.com (Settings > API Keys).
DEEPGRAM_API_KEY=

# Opcional: transcrição alternativa pela API Whisper ou geração com a OpenAI.
# Configure o cliente separadamente: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcional: efeitos sonoros gerados pelo motion-showreel (scripts/sfx.mjs).
# Precisa de acesso a "sound effects": https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Opcional: geração de vídeo e imagem (B-roll com IA). Exige créditos próprios
# e integração por modelo: https://docs.kie.ai/
KIE_API_KEY=

# Opcional: descrições com Gemini no fluxo website-to-video.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: transcrição Whisper via Groq citada na referência do framework.
# https://console.groq.com/keys
GROQ_API_KEY=

# Só para os exemplos antigos que chamam o ClickUp.
CLICKUP_API_KEY=
